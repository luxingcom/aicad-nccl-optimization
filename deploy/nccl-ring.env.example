# =============================================================
# nccl-ring.env.example — 环网栈容器 env 样例（deploy-kit v1.1，2026-09-19）
# -------------------------------------------------------------
# ⚠️ 三条实录教训已内建为检查项，请先读完注释再改值：
#
# 【坑9】键名要认准「生效的那一个」：
#   - 想设 NCCL_IB_HCA → 实际生效键可能是 IB_HCA（由启动脚本 -e "NCCL_IB_HCA=$IB_HCA" 转发）
#   - NCCL_DEBUG_FILE 等不透传的键 → 必须追加进 EXTRA_DOCKER_ENV
#   - 判断方法（唯一权威）：起栈后
#     docker inspect <container> --format '{{range .Config.Env}}{{println .}}{{end}}'
#     看【容器真实 env】，不要看本文件。（tools/doctor.sh 第 2 项已自动化）
#
# 【坑10】API_KEY 必须四机同值：仅 head 设置或值不一致 ⇒ 鉴权行为分裂。
#   doctor.sh 会输出四机 API_KEY 指纹，指纹不一致即坑10。
#
# 【错误4】LD_PRELOAD 里路径不存在【不会报错】，glibc 静默跳过：
#   「vLLM 能跑通」≠ ring-only 库真被加载。doctor.sh 第 4/6 项显式校验
#   路径存在性 + RING-ONLY 日志条数。
# =============================================================

# ---------- 鉴权（四机同值！）----------
API_KEY=<SET-SAME-VALUE-ON-ALL-4-NODES>

# ---------- 环网 NCCL（v5 库：ADR-015 内建默认表 + ADR-016 运行期覆盖）----------
NCCL_ALGO=RING
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_BUFFSIZE=8388608

# v5 新增（ADR-016）：运行期 per-peer 设备映射。
# 两个都留空  => 库内建 v4 默认表（与 ADR-015 生产行为逐位一致）。
# 由 tools/gen_devmap.py --topology topology.json 生成，勿手写。
# 字符串形态（优先）：
#NCCL_RING_DEV_MAP=r0:1=1,3;3=0,2;r1:0=1,3;2=0,2;r2:1=0,2;3=1,3;r3:0=0,2;2=1,3
# 文件形态（四机统一放已挂载路径；容器内须可读）：
#NCCL_RING_DEV_MAP_FILE=/state/ring-devmap.json

# per-size tuner（ADR-014/双分支加固）
NCCL_TUNER_THRESHOLD=40960
NCCL_NET_PLUGIN=none

# ---------- IB 设备/网络 ----------
# ⚠️ 坑9：此键在部分启动脚本里叫 IB_HCA；确认你的脚本用哪个名字！
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_IB_GID_INDEX=3
NCCL_IB_TIMEOUT=1000
NCCL_IB_RETRY_CNT=7
NCCL_IB_TOS=46
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=1
NCCL_SOCKET_IFNAME=enP7s7
NCCL_IGNORE_CPU_AFFINITY=1

# ---------- 调试（坑4：NCCL_DEBUG_FILE 必须落在【已挂载】路径！）----------
# /cache 未挂载进容器 ⇒ NCCL 打不开文件 ⇒ 调试输出静默全丢，真因被掩盖一整轮（实录坑4）。
# 用 /state 等容器挂载点；doctor.sh 第 3 项自动校验可写性。
NCCL_DEBUG=INFO
NCCL_DEBUG_FILE=/state/nccl-debug-%h-%p.log
NCCL_DEBUG_SUBSYS=INIT,ENV,NET,GRAPH,TUNING,P2P,PROXY,ALLOC,BOOTSTRAP
NCCL_SET_THREAD_NAME=1

# ---------- 追加透传（坑9：不透传的键从这里走）----------
# EXTRA_DOCKER_ENV=-e NCCL_RING_DEV_MAP_FILE=/state/ring-devmap.json
