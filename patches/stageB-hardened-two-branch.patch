+// === PerSize LL/Simple 双带覆盖 (Stage B hardened, 2026-08-16) ===
+// 目标: decode 小 allreduce(<=40KB) 走 LL, prefill 大 allreduce(>40KB) 走 Simple
+// 依据: nccl-proto-threshold-scan / nccl-tuner-implementation (ADR-014)
+// 加固 (ADR-014/015, stageB-hardened-two-branch): 将覆盖逻辑从 else 分支提升为 if/else 双分支生效,
+//   消除对 NCCL_NET_PLUGIN=none 的隐式依赖。即使 SPCX tuner (comm->tuner!=NULL) 存在,
+//   getCollInfo 返回后仍强制按阈值改写 cost table, 由随后的 topoGetAlgoInfo 选出 LL/Simple。
+//   仅干预 allreduce; 其余 collective 交回 NCCL 默认; 不碰 nChannels; 跳过 IGNORE(-1.0) 组合。
+static void ncclPersizeTunerOverride(struct ncclComm* comm, struct ncclTaskColl* info, size_t nBytes,
+                                     float** collCostTable) {
+  if (info->func != ncclFuncAllReduce) return;
+  float (*table)[NCCL_NUM_PROTOCOLS] = (float (*)[NCCL_NUM_PROTOCOLS])collCostTable;
+  size_t th = 40960u;
+  const char* tenv = ncclGetEnv("NCCL_TUNER_THRESHOLD");
+  if (tenv != NULL && tenv[0] != 0) {
+    long t = strtol(tenv, NULL, 10);
+    if (t > 0) th = (size_t)t;
+  }
+  int wantProto = (nBytes <= th) ? NCCL_PROTO_LL : NCCL_PROTO_SIMPLE;
+  for (int a = 0; a < NCCL_NUM_ALGORITHMS; a++) {
+    for (int pr = 0; pr < NCCL_NUM_PROTOCOLS; pr++) {
+      if (table[a][pr] == -1.0f) continue;  // IGNORE 防御
+      table[a][pr] = (pr == wantProto) ? 0.0f : 1e18f;
+    }
+  }
+  if (ncclGetEnv("NCCL_TUNER_DEBUG") != NULL) {
+    INFO(NCCL_TUNING, "PerSizeTuner: allreduce nBytes=%zu -> %s",
+         nBytes, wantProto == NCCL_PROTO_LL ? "LL" : "Simple");
+  }
+}
