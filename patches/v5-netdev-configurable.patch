+/* ============================================================
+ * RING-ONLY PATCH v5 (ADR-015 + ADR-016): configurable per-peer dual-dev map.
+ *
+ * Built-in default (identical to v4 production table, ADR-015):
+ *   ring 0-1-2-3-0; dev index = NCCL_IB_HCA order 0..3;
+ *   even channel -> devA, odd channel -> devB.
+ *
+ * Runtime override (ADR-016, replaces "rebuild the library on every rewire"):
+ *   NCCL_RING_DEV_MAP="r0:1=1,3;3=0,2;r1:0=1,3;2=0,2;r2:1=0,2;3=1,3;r3:0=0,2;2=1,3"
+ *     rank entries separated by ';', each entry "r<rank>:" followed by
+ *     comma-separated "<peer>=<devA>,<devB>" pairs.
+ *   NCCL_RING_DEV_MAP_FILE=/path/to/ring-devmap.json
+ *     {"0": {"1":[1,3], "3":[0,2]}, "1": {...}, "2": {...}, "3": {...}}
+ *
+ * Semantics:
+ *   - Both vars empty                 -> built-in v4 default (production-compatible).
+ *   - Pairs absent for a (rank,peer)  -> keep NCCL default device selection.
+ *   - Malformed input                 -> WARN + fall back to built-in default (fail-safe,
+ *                                        never fails comm init; verify with doctor before prod).
+ *   - NCCL_RING_DEV_MAP takes precedence over the FILE form.
+ *   - Dev indexes map onto NCCL_IB_HCA order (same as v4).
+ * ============================================================ */
+#include <cstdio>
+
+static int ncclRingMapParseFailCount = 0;
+
+static void ncclRingMapWarn(const char* fmt, ...) {
+  /* rate-limited: at most 8 warnings per process */
+  if (++ncclRingMapParseFailCount > 8) return;
+  va_list args;
+  va_start(args, fmt);
+  char line[256];
+  vsnprintf(line, sizeof(line), fmt, args);
+  va_end(args);
+  WARN("RING-ONLY v5: %s", line);
+}
+
+struct ncclRingMapEntry { int peer; int devA; int devB; };
+
+struct ncclRingMap {
+  int nEntries[4];                       /* valid entry count per rank */
+  struct ncclRingMapEntry entries[4][4]; /* max 4 peers per rank */
+  int loaded;
+};
+
+static struct ncclRingMap ncclRingMapBuiltins() {
+  struct ncclRingMap m;
+  memset(&m, 0, sizeof(m));
+  /* v4 default table (ADR-015): row = myRank, col = peerRank */
+  static const int def[4][4][2] = {
+    {{0,0},{1,3},{0,0},{0,2}},
+    {{1,3},{0,0},{0,2},{0,0}},
+    {{0,0},{0,2},{0,0},{1,3}},
+    {{0,2},{0,0},{1,3},{0,0}},
+  };
+  for (int r = 0; r < 4; r++) {
+    int n = 0;
+    for (int p = 0; p < 4; p++) {
+      if (p == r) continue;
+      if (def[r][p][0] == 0 && def[r][p][1] == 0) continue;  /* non-adjacent sentinel */
+      m.entries[r][n].peer = p;
+      m.entries[r][n].devA = def[r][p][0];
+      m.entries[r][n].devB = def[r][p][1];
+      n++;
+    }
+    m.nEntries[r] = n;
+  }
+  m.loaded = 1;
+  return m;
+}
+
+/* parse "r0:1=1,3;3=0,2;r1:..." ; returns 0 on success, -1 on malformed input */
+static int ncclRingMapParseString(const char* s, struct ncclRingMap* m) {
+  memset(m, 0, sizeof(m));
+  int seen[4] = {0,0,0,0};
+  const char* p = s;
+  while (*p) {
+    if (p[0] != 'r' || p[1] < '0' || p[1] > '3' || p[2] != ':') return -1;
+    int r = p[1] - '0';
+    if (seen[r]) return -1;                 /* duplicate rank entry */
+    seen[r] = 1;
+    p += 3;
+    int n = 0;
+    while (1) {
+      if (p[0] < '0' || p[0] > '3' || p[1] != '=') return -1;
+      int peer = p[0] - '0';
+      if (peer == r) return -1;
+      if (p[2] < '0' || p[2] > '3' || p[3] != ',' || p[4] < '0' || p[4] > '3') return -1;
+      for (int k = 0; k < n; k++) if (m->entries[r][k].peer == peer) return -1;
+      m->entries[r][n].peer = peer;
+      m->entries[r][n].devA = p[2] - '0';
+      m->entries[r][n].devB = p[4] - '0';
+      n++;
+      p += 5;
+      if (*p == ';') { p++; break; }        /* next rank entry */
+      if (*p == 0) break;
+      return -1;                            /* junk between pairs */
+    }
+    m->nEntries[r] = n;
+  }
+  for (int r = 0; r < 4; r++) if (!seen[r]) return -1;  /* all 4 ranks required */
+  return 0;
+}
+
+/* parse the JSON subset {"0":{"1":[a,b],...},...} with a tiny hand-rolled scanner */
+static int ncclRingMapParseFile(const char* path, struct ncclRingMap* m) {
+  memset(m, 0, sizeof(m));
+  FILE* f = fopen(path, "r");
+  if (f == NULL) return -1;
+  static char buf[4096];
+  size_t n = fread(buf, 1, sizeof(buf)-1, f);
+  fclose(f);
+  buf[n] = 0;
+  int seen[4] = {0,0,0,0};
+  const char* p = buf;
+  while (*p && *p != '{') p++;
+  if (*p != '{') return -1;
+  p++;
+  while (*p && *p != '}') {
+    while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' || *p == ',') p++;
+    if (*p == '}' || *p == 0) break;
+    if (p[0] != '"' || p[1] < '0' || p[1] > '3' || p[2] != '"') return -1;
+    int r = p[1] - '0';
+    if (seen[r]) return -1;
+    seen[r] = 1;
+    p += 3;
+    while (*p == ' ' || *p == ':') p++;
+    if (*p != '{') return -1;
+    p++;
+    int nn = 0;
+    while (*p && *p != '}') {
+      while (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' || *p == ',') p++;
+      if (*p == '}' || *p == 0) break;
+      if (p[0] != '"' || p[1] < '0' || p[1] > '3' || p[2] != '"') return -1;
+      int peer = p[1] - '0';
+      if (peer == r) return -1;
+      p += 3;
+      while (*p == ' ' || *p == ':') p++;
+      if (p[0] != '[' || p[1] < '0' || p[1] > '3' || p[2] != ',' || p[3] < '0' || p[3] > '3' || p[4] != ']') return -1;
+      for (int k = 0; k < nn; k++) if (m->entries[r][k].peer == peer) return -1;
+      m->entries[r][nn].peer = peer;
+      m->entries[r][nn].devA = p[1] - '0';
+      m->entries[r][nn].devB = p[3] - '0';
+      nn++;
+      p += 5;
+    }
+    if (*p == '}') p++;
+    m->nEntries[r] = nn;
+  }
+  for (int r = 0; r < 4; r++) if (!seen[r]) return -1;
+  return 0;
+}
+
+static void ncclRingMapLoad(struct ncclRingMap* m) {
+  const char* s = ncclGetEnv("NCCL_RING_DEV_MAP");
+  if (s != NULL && s[0] != 0) {
+    if (ncclRingMapParseString(s, m) == 0) {
+      INFO(NCCL_INIT, "RING-ONLY v5: per-peer dev map from NCCL_RING_DEV_MAP");
+      return;
+    }
+    ncclRingMapWarn("NCCL_RING_DEV_MAP malformed (%s) - falling back to built-in v4 map", s);
+  } else {
+    const char* f = ncclGetEnv("NCCL_RING_DEV_MAP_FILE");
+    if (f != NULL && f[0] != 0) {
+      if (ncclRingMapParseFile(f, m) == 0) {
+        INFO(NCCL_INIT, "RING-ONLY v5: per-peer dev map from NCCL_RING_DEV_MAP_FILE=%s", f);
+        return;
+      }
+      ncclRingMapWarn("NCCL_RING_DEV_MAP_FILE=%s unreadable/malformed - falling back to built-in v4 map", f);
+    }
+  }
+  *m = ncclRingMapBuiltins();
+}
+
+static void ncclRingDevOverride(int myRank, int peerRank, int channelId, int* dev) {
+  static struct ncclRingMap map;
+  static int mapLoaded = 0;
+  if (!mapLoaded) { ncclRingMapLoad(&map); mapLoaded = 1; }
+  if (myRank < 0 || myRank > 3 || peerRank < 0 || peerRank > 3) return;
+  for (int i = 0; i < map.nEntries[myRank]; i++) {
+    if (map.entries[myRank][i].peer == peerRank) {
+      int want = (channelId % 2 == 0) ? map.entries[myRank][i].devA
+                                      : map.entries[myRank][i].devB;
+      INFO(NCCL_INIT, "RING-ONLY v5 rank %d->%d chan %d dev %d (was %d)",
+           myRank, peerRank, channelId, want, *dev);
+      *dev = want;
+      return;
+    }
+  }
+  /* no entry for this peer: keep NCCL default device selection */
+}
